# Copy to .env and fill in. Never commit real secrets (spec §38).

# Local SQLite database file (relative to the prisma/ directory).
DATABASE_URL="file:./dev.db"

# Anthropic API key for the AI assistant (Phase 5). Server-side only.
# Leave empty in Phase 1 — the assistant is not wired up yet and degrades gracefully.
ANTHROPIC_API_KEY=""
