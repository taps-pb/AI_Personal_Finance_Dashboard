# Copy to .env and fill in. Never commit real secrets (spec §38).

# Local SQLite database file (relative to the prisma/ directory).
DATABASE_URL="file:./dev.db"

# AI assistant — Groq (OpenAI-compatible API). Server-side only.
# Leave empty to disable the assistant; it degrades gracefully.
GROQ_API_KEY=""
# Optional: override the model (must support tool calling).
GROQ_MODEL="openai/gpt-oss-120b"
