// Phase 1 schema. SQLite has no enums, so `type`/`status`/`reason`/`kind` are
// Strings validated in app code against unions in lib/constants.ts. Money is
// integer paise (Int). Every row carries userId for future multi-user (spec §39).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  createdAt    DateTime      @default(now())
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  subscriptions Subscription[]
  recurring    RecurringTransaction[]
  budgets      Budget[]
  netWorthSnapshots NetWorthSnapshot[]
  savingsGoals SavingsGoal[]
  setting      Setting?
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  institution       String?
  type              String // AccountType (lib/constants.ts)
  currency          String   @default("INR")
  balanceMinor      BigInt      @default(0) // asset: value; liability: outstanding
  includeInNetWorth Boolean  @default(true)
  status            String   @default("active") // active | archived
  nickname          String?
  description       String?
  icon              String?
  color             String?
  // credit-card / loan fields (nullable)
  creditLimitMinor  BigInt?
  statementDay      Int?
  dueDay            Int?
  minDueMinor       BigInt?
  // investment field (nullable)
  investedMinor     BigInt?
  isDemo            Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  balanceHistory BalanceHistory[]
  txnsFrom       Transaction[]          @relation("from")
  txnsTo         Transaction[]          @relation("to")
  subscriptions  Subscription[]
  recurFrom      RecurringTransaction[] @relation("recurFrom")
  recurTo        RecurringTransaction[] @relation("recurTo")
  savingsGoals   SavingsGoal[]

  @@index([userId])
}

model BalanceHistory {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  previousMinor BigInt
  newMinor      BigInt
  diffMinor     BigInt
  reason        String // INITIAL | MANUAL_UPDATE | TRANSACTION | RECONCILE
  transactionId String?
  note          String?
  createdAt     DateTime @default(now())

  @@index([accountId])
}

model Category {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  kind     String // expense | income
  parentId String?
  parent   Category?  @relation("sub", fields: [parentId], references: [id])
  children Category[] @relation("sub")
  icon     String?
  color    String?

  transactions Transaction[]
  subscriptions Subscription[]
  recurring     RecurringTransaction[]
  budgets       Budget[]

  @@index([userId])
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String // TxnType (lib/constants.ts)
  amountMinor   BigInt
  name          String
  description   String?
  date          DateTime
  accountId     String
  account       Account  @relation("from", fields: [accountId], references: [id])
  toAccountId   String?
  toAccount     Account? @relation("to", fields: [toAccountId], references: [id])
  feeMinor      BigInt?
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  merchant      String?
  paymentMethod String?
  tags          String? // comma-separated
  recurring     Boolean  @default(false)
  subscriptionId String?
  subscription   Subscription? @relation("subscription", fields: [subscriptionId], references: [id])
  isDemo        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, date])
  @@index([accountId])
  @@index([type])
  @@index([categoryId])
  @@index([subscriptionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  timestamp DateTime @default(now())
  action    String
  entity    String
  entityId  String
  before    String? // JSON snapshot
  after     String? // JSON snapshot

  @@index([userId])
}

model Setting {
  id                      String  @id @default(cuid())
  userId                  String  @unique
  user                    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  autoUpdateBalances      Boolean @default(true)
  defaultExpenseAccountId String?
  defaultIncomeAccountId  String?
  currency                String  @default("INR")
  dateFormat              String  @default("dd MMM yyyy")
  timezone                String  @default("Asia/Kolkata")
}

model Subscription {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  provider        String?
  amountMinor     BigInt
  frequency       String // BillingFrequency (lib/finance/metrics.ts)
  intervalDays    Int? // for custom frequency
  startDate       DateTime
  nextBillingDate DateTime
  lastChargedDate DateTime?
  accountId       String?
  account         Account?  @relation(fields: [accountId], references: [id])
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  status          String    @default("active") // active | paused | cancelled
  autoRenew       Boolean   @default(true)
  notes           String?
  isDemo          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  transactions Transaction[] @relation("subscription")

  @@index([userId])
  @@index([nextBillingDate])
}

model RecurringTransaction {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String // TxnType
  amountMinor  BigInt
  name         String
  accountId    String
  account      Account   @relation("recurFrom", fields: [accountId], references: [id])
  toAccountId  String?
  toAccount    Account?  @relation("recurTo", fields: [toAccountId], references: [id])
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  frequency    String
  intervalDays Int?
  nextDate     DateTime
  lastRunDate  DateTime?
  notes        String?
  isDemo       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([nextDate])
}

model Budget {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String? // null = overall/global budget
  category   Category? @relation(fields: [categoryId], references: [id])
  amountMinor BigInt
  isDemo     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, categoryId])
  @@index([userId])
}

model NetWorthSnapshot {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                  DateTime
  totalAssetsMinor      BigInt
  totalLiabilitiesMinor BigInt
  netWorthMinor         BigInt
  isDemo                Boolean  @default(false)
  createdAt             DateTime @default(now())

  @@index([userId, date])
}

model SavingsGoal {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  targetMinor    BigInt
  currentMinor   BigInt       @default(0)
  targetDate     DateTime?
  linkedAccountId String?
  linkedAccount  Account?  @relation(fields: [linkedAccountId], references: [id])
  priority       String    @default("medium") // low | medium | high
  notes          String?
  isDemo         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}
